---
import '@fontsource/great-vibes/400.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import wedding from '../data/wedding.json';

const families = [wedding.families.groom, wedding.families.bride];
---

<section class="families-section" aria-labelledby="families-title" data-motion-zone>
  <h2 id="families-title" class="sr-only">Lời mời từ hai gia đình</h2>

  <div class="families">
    {families.map((family) => (
      <div class="family" data-invitation-reveal>
        <h3>{family.label}</h3>
        <p class="parent"><span class="parent-label">{family.father.label.toLocaleLowerCase('vi-VN')}</span> {family.father.fullName}</p>
        <p class="parent"><span class="parent-label">{family.mother.label.toLocaleLowerCase('vi-VN')}</span> {family.mother.fullName}</p>
      </div>
    ))}
  </div>

  <div class="invitation-wording" data-invitation-reveal>
  <p class="invitation-title">{wedding.announcement.invitationTitle}</p>
  <p class="invitation-copy">{wedding.announcement.invitationText}</p>
  <div class="floral-rule" aria-hidden="true">
    <span></span>
    <svg viewBox="0 0 80 30" fill="none">
      <path d="M5 22C25 22 49 17 73 7M24 20C15 19 14 12 14 12C23 11 28 15 24 20ZM39 16C31 13 34 6 34 6C42 7 44 12 39 16ZM49 13C52 20 61 19 61 19C59 12 54 10 49 13ZM63 10C61 3 66 1 66 1C71 6 68 9 63 10Z" stroke="currentColor" stroke-width="1" />
    </svg>
    <span></span>
  </div>
  </div>
</section>

<style>
  .families-section { padding: 30px 24px 0; color: #344b3d; font-family: 'Cormorant Garamond', Georgia, serif; text-align: center; }
  .families { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-bottom: 35px; }
  .family { min-width: 0; }
  h3 { margin: 0 0 13px; color: #6e785e; font-size: 14px; font-weight: 400; letter-spacing: .19em; text-transform: uppercase; }
  .parent { margin: 6px 0; font-size: 19px; line-height: 1.45; text-wrap: balance; }
  .parent-label { text-transform: capitalize; }
  .invitation-title { margin: 0; font: 400 clamp(31px, 9cqw, 39px)/1.4 'Great Vibes', cursive; }
  .invitation-copy { max-width: 280px; margin: 9px auto 18px; font-size: 20px; line-height: 1.45; text-wrap: balance; }
  .floral-rule { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 26px auto 20px; color: #82916f; }
  .floral-rule span { width: 34px; height: 1px; background: linear-gradient(90deg, transparent, currentColor); opacity: .5; }
  .floral-rule span:last-child { rotate: 180deg; }
  .floral-rule svg { width: 66px; height: 28px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 350px) {
    .families-section { padding-inline: 20px; }
    .families { gap: 9px; }
    .parent { font-size: 18px; }
  }
</style>
