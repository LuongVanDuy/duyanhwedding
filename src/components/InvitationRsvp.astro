---
import '@fontsource/great-vibes/400.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import content from '../data/wedding-rsvp.json';
const endpoint = import.meta.env.PUBLIC_WISHES_API_URL ?? '';
---
<section class="rsvp-section" aria-labelledby="rsvp-title" data-motion-zone data-wishes data-endpoint={endpoint}>
  <header class="rsvp-heading">
    <p class="eyebrow" data-reveal>{content.eyebrow}</p>
    <h2 id="rsvp-title" data-reveal>{content.title}</h2>
    <p class="rsvp-intro" data-reveal>{content.intro}</p>
  </header>
  <div class="wish-board" data-board data-reveal>
    <div class="wish-window" data-wish-window tabindex="0" role="region" aria-label="Lời chúc; chạm giữ hoặc rê chuột để dừng" aria-describedby="wish-board-hint">
      <div class="wish-track" data-track>
        <div class="wish-group" data-wish-group="0" role="list"></div>
        <div class="wish-group" data-wish-group="1" aria-hidden="true" inert></div>
      </div>
    </div>
    <p class="board-state" data-board-state role="status">Đang mở những lời chúc…</p>
    <p class="board-hint" id="wish-board-hint">Chạm giữ một tờ giấy để đọc lâu hơn</p>
  </div>
  <button class="write-wish" type="button" data-open-wish data-reveal disabled>Nhập lời chúc <span aria-hidden="true">↗</span></button>
  <p class="send-confirmation" data-send-confirmation role="status" aria-live="polite"></p>
  <noscript><p class="board-state">Bạn bật JavaScript để xem và gửi lời chúc, hoặc nhắn trực tiếp cho Duy và Ánh nhé.</p></noscript>

  <dialog class="wish-dialog" aria-labelledby="wish-dialog-title" data-wish-dialog>
    <div class="reply-paper">
      <button class="close-wish" type="button" data-close-wish aria-label="Đóng cửa sổ lời chúc">×</button>
      <span class="letter-tape" aria-hidden="true"></span>
      <header class="letter-top"><h3 id="wish-dialog-title">Đôi dòng gửi hai bạn</h3><span aria-hidden="true">D &amp; A</span></header>
      <form id="wish-form">
        <fieldset id="wish-fields" disabled>
          <legend class="sr-only">Viết lời chúc cho Duy và Ánh</legend>
          <div class="field">
            <label for="wish-name">Tên của bạn <span aria-hidden="true">*</span></label>
            <input id="wish-name" name="guestName" autocomplete="name" required maxlength="80" placeholder="Bạn tên là…" />
          </div>
          <div class="field">
            <label for="wish-message">Lời chúc của bạn <span aria-hidden="true">*</span></label>
            <textarea id="wish-message" name="message" rows="4" required maxlength="600" placeholder="Chúc Duy & Ánh…"></textarea>
          </div>
          <div class="honey-field" aria-hidden="true"><label for="wish-website">Website</label><input id="wish-website" name="website" tabindex="-1" autocomplete="off" /></div>
          <p class="delivery-note" id="wish-delivery">Lời chúc và tên của bạn sẽ được lưu và xuất hiện trên thiệp.</p>
          <button class="primary-button" type="submit" aria-describedby="wish-delivery">Gửi lời chúc <span aria-hidden="true">↗</span></button>
        </fieldset>
      </form>
      <p id="wish-status" class="reply-status" role="status" aria-live="polite"></p>
      <p class="signature">{content.signature}</p>
    </div>
  </dialog>
  <template id="wish-template">
    <article class="wish-paper" role="listitem">
      <span class="paper-pin" aria-hidden="true"></span>
      <span class="paper-heart" aria-hidden="true">♡</span>
      <p class="wish-message"></p>
      <p class="wish-author"></p>
    </article>
  </template>
</section>
<script>
  import '../scripts/wishes';
</script>
<style>
  .rsvp-section { --wish-ink: #344b3d; --wish-paper: #f8f3e9; position: relative; isolation: isolate; padding: 48px 0 52px; background: #243c30; color: var(--wish-paper); font-family: 'Cormorant Garamond', Georgia, serif; }
  .rsvp-section::before { content: ''; position: absolute; z-index: -1; inset: 0; background: url('/images/paper-grain.svg'); opacity: .25; pointer-events: none; }
  .rsvp-heading { padding-inline: 25px; text-align: center; }
  .eyebrow { margin: 0 0 17px; text-transform: uppercase; font-size: 14px; letter-spacing: .22em; }
  h2 { max-width: 340px; margin: auto; font: 400 clamp(40px, 11.5cqw, 50px)/1.3 'Great Vibes', cursive; text-wrap: balance; }
  .rsvp-intro { max-width: 310px; margin: 18px auto 12px; font-size: 20px; line-height: 1.55; color: #dedfce; text-wrap: balance; }
  .wish-board { position: relative; }
  .wish-board::before { content: ''; position: absolute; top: 31px; left: 0; width: 100%; height: 1px; background: #b8ad8970; transform: rotate(-2deg); }
  .wish-window { overflow-x: auto; scrollbar-width: thin; scrollbar-color: #9aab91 transparent; padding: 35px 0 24px; }
  .wish-track { display: flex; width: max-content; }
  .wish-group { display: flex; align-items: flex-start; gap: 21px; padding: 0 21px 0 0; }
  .wish-group:first-child { margin-left: 24px; }
  .wish-group[aria-hidden='true'] { display: none; }
  .wish-paper { position: relative; display: flex; flex-direction: column; width: 258px; min-height: 270px; padding: 29px 23px 23px; background: #f7f0dc; color: #344b3d; box-shadow: 2px 9px 14px #0e22172e; rotate: -3deg; transform-origin: 50% 8px; }
  .wish-paper::after { content: ''; position: absolute; inset: 0; background: url('/images/paper-grain.svg'); opacity: .3; pointer-events: none; }
  .wish-paper[data-tone='1'] { background: #ecddd3; rotate: 2.5deg; margin-top: 10px; }
  .wish-paper[data-tone='2'] { background: #e3e8d8; rotate: -1deg; margin-top: 3px; }
  .paper-pin { position: absolute; z-index: 1; top: -7px; left: calc(50% - 6px); width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 35% 25%, #e4d6b0, #ab885b 60%, #765e43); box-shadow: 1px 3px 2px #3c362a42; }
  .paper-heart { position: absolute; top: 14px; right: 17px; font-size: 23px; color: #917759; }
  .wish-message { margin: 12px 0 20px; font-size: 20px; font-style: italic; line-height: 1.55; overflow-wrap: anywhere; white-space: pre-line; }
  .wish-author { margin: auto 0 0; font: 27px/1.35 'Great Vibes', cursive; overflow-wrap: anywhere; }
  .is-moving .wish-window { overflow: hidden; }
  .is-moving .wish-group:first-child { margin-left: 0; }
  .is-moving .wish-group[aria-hidden='true'] { display: flex; }
  .is-moving .wish-track { animation: paper-procession var(--wish-duration, 40s) linear infinite; animation-play-state: paused; }
  .is-moving.is-in-view .wish-track { animation-play-state: running; }
  .is-moving.is-held .wish-track, .is-moving.is-modal-open .wish-track, .is-moving .wish-window:focus-visible .wish-track { animation-play-state: paused; }
  @media (hover: hover) { .is-moving .wish-track:has(.wish-paper:hover) { animation-play-state: paused; } }
  @keyframes paper-procession { to { transform: translateX(-50%); } }
  .board-state, .send-confirmation { margin: 16px 28px; text-align: center; font-size: 17px; line-height: 1.5; }
  .board-state:empty, .send-confirmation:empty { display: none; }
  .board-hint { margin: 5px 24px 0; color: #dadcca; text-align: center; font-size: 17px; font-style: italic; }
  .write-wish { display: flex; align-items: center; justify-content: center; gap: 22px; min-height: 52px; margin: 26px auto 0; padding: 12px 30px; border: 1px solid #d3d4b8; background: #f8f3e9; color: #344b3d; font: 20px 'Cormorant Garamond', Georgia, serif; cursor: pointer; }
  .write-wish:hover { background: #e9eddf; }
  .wish-dialog { width: min(calc(100% - 32px), 390px); max-height: calc(100dvh - 32px); max-width: none; padding: 0; border: 0; color: var(--wish-ink); background: var(--wish-paper); overflow-y: auto; overscroll-behavior: contain; }
  .wish-dialog[open] { animation: letter-appear 280ms ease-out; }
  .wish-dialog::backdrop { background: rgb(13 29 21 / 70%); backdrop-filter: blur(4px); }
  @keyframes letter-appear { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }
  .reply-paper { position: relative; padding: 48px 26px 25px; }
  .close-wish { position: absolute; top: 3px; right: 3px; min-width: 44px; min-height: 44px; padding: 0; border: 0; background: transparent; color: #344b3d; font: 28px Georgia, serif; cursor: pointer; }
  .letter-tape { position: absolute; top: 3px; left: calc(50% - 36px); width: 72px; height: 19px; background: #c5c9acbb; transform: rotate(-5deg); }
  .letter-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 24px; }
  h3 { margin: 0; font: 30px/1.35 'Great Vibes', cursive; }
  .letter-top > span { color: #7d866c; font-size: 14px; white-space: nowrap; letter-spacing: .08em; }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .field { margin-bottom: 20px; }
  label { display: block; font-size: 20px; line-height: 1.4; }
  input, textarea { display: block; width: 100%; min-width: 0; margin-top: 5px; padding: 10px 0; border: 0; border-bottom: 1px solid #a9b09b; border-radius: 0; color: var(--wish-ink); background: transparent; font: 19px/1.6 'Cormorant Garamond', Georgia, serif; }
  input { min-height: 48px; }
  textarea { resize: vertical; min-height: 125px; }
  input::placeholder, textarea::placeholder { color: #6c715d; opacity: 1; }
  .delivery-note { color: #626653; font-size: 17px; line-height: 1.5; margin: 0 0 17px; }
  .primary-button { display: flex; align-items: center; justify-content: center; gap: 17px; width: 100%; min-height: 50px; padding: 11px; border: 1px solid var(--wish-ink); background: var(--wish-ink); color: var(--wish-paper); font: 20px/1.4 'Cormorant Garamond', Georgia, serif; cursor: pointer; }
  .primary-button:hover { background: #22392c; }
  button:disabled { cursor: default; opacity: .6; }
  .reply-status { font-size: 16px; line-height: 1.5; }
  .reply-status:empty { display: none; }
  .signature { margin: 23px 0 0; text-align: center; font: 26px/1.5 'Great Vibes', cursive; }
  :is(input, textarea, button):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .wish-window:focus-visible { outline: 1px solid #e0ddc1; outline-offset: -4px; }
  .honey-field, .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 350px) { .wish-paper { width: 242px; } .reply-paper { padding-inline: 21px; } h3 { font-size: 27px; } }
  @media (prefers-reduced-motion: reduce) { .wish-track, .wish-dialog[open] { animation: none !important; } }
</style>
